# Copy to .env.docker_production (production) or .env.docker_local (local). Never commit the copies.
# Each comment sits on its own line: Compose env_file and the app's parser read every value exactly.
#
# production | local (missing = production)
APP_ENV=production
# Honoured only when APP_ENV=local
DEBUG=0
# Production refuses to start while this is the example value
SECRET_KEY=change-me-to-a-long-random-string
# The single admin account; synced from these two values on every deploy
ADMIN_USERNAME=admin
# Production refuses to start while this is the example value
ADMIN_PASSWORD=change-me-admin-password
POSTGRES_DB=powermon
POSTGRES_USER=powermon
# Production refuses to start while this is the example value. The postgres image reads it only at first init.
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Production: the Caddy site name; the heartbeat URL is https://DOMAIN/hb
DOMAIN=power.example.com
# Production: the ACME (Let's Encrypt) account email
ACME_EMAIL=you@example.com
# Display time zone; canonical IANA name only (Europe/Kiev is rejected)
DISPLAY_TZ=Europe/Kyiv
# Local only; production derives https://DOMAIN
PUBLIC_BASE_URL=http://localhost:8000
# Optional admin ops chat (set both or neither): a bot token from @BotFather
OPS_BOT_TOKEN=
# Optional admin ops chat: its numeric chat ID, e.g. -1001234567890
OPS_CHAT_ID=
# Undelivered alerts expire after this many hours (1-48)
ALERT_MAX_AGE_HOURS=6
# DEBUG, INFO, WARNING or ERROR; tokens and keys are redacted at every level
LOG_LEVEL=INFO
